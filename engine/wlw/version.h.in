#pragma once

// WLWengine's version. Generated by CMake from project(VERSION) in the top-level CMakeLists.txt (template:
// engine/wlw/version.h.in); edit the version there, never the generated file.
//
// SemVer below 1.0: a minor version may break the API (for now without deprecation shims: CLAUDE.md "Versioning";
// core/deprecated.h is the tool for later), a patch only fixes. One minor version per finished roadmap phase; each
// is a git tag (v0.1.0).
// Run-time details (git commit, build type): core/build_info.h.

#define WLW_VERSION_MAJOR @WLWengine_VERSION_MAJOR@
#define WLW_VERSION_MINOR @WLWengine_VERSION_MINOR@
#define WLW_VERSION_PATCH @WLWengine_VERSION_PATCH@
#define WLW_VERSION_STRING "@WLWengine_VERSION_MAJOR@.@WLWengine_VERSION_MINOR@.@WLWengine_VERSION_PATCH@"

// One comparable number: major * 10000 + minor * 100 + patch (0.3.1 = 301). Minor and patch stay below 100.
#define WLW_MAKE_VERSION(major, minor, patch) ((major) * 10000 + (minor) * 100 + (patch))
#define WLW_VERSION WLW_MAKE_VERSION(WLW_VERSION_MAJOR, WLW_VERSION_MINOR, WLW_VERSION_PATCH)

// For game code that has to build against two engine versions for a while:
//   #if WLW_VERSION_AT_LEAST(0, 3, 0)  ...new API...  #else  ...old API...  #endif
#define WLW_VERSION_AT_LEAST(major, minor, patch) (WLW_VERSION >= WLW_MAKE_VERSION(major, minor, patch))
