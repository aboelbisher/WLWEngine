# Normalize line endings in the repo; VS files stay CRLF on checkout
* text=auto
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf
*.sh      text eol=lf

# Binary assets go through Git LFS
*.bin   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.lib   filter=lfs diff=lfs merge=lfs -text

# Golden-image references: small, and CI reads them without LFS (see tests/gpu/golden.h)
tests/gpu/references/*.png -filter -diff -merge binary
