# Formats the engine's C++ (engine/, kit/, tests/, benchmarks/, samples/; never third_party/) with one pinned
# clang-format, so every machine and CI produce the same result. Nothing to install: the first run downloads
# clang-format's PyPI wheel for this OS (a zip with the binary, SHA-256 checked) into build/tools/.
#   cmake -P cmake/ClangFormat.cmake              reformat every file in place
#   cmake -DCHECK=ON -P cmake/ClangFormat.cmake   change nothing: list the files that differ, fail if any (CI)
# Style: .clang-format. Commits that only reformat go in .git-blame-ignore-revs.
cmake_minimum_required(VERSION 3.21)

set(version 23.1.3)
set(pypi "https://files.pythonhosted.org/packages")
cmake_host_system_information(RESULT os_name QUERY OS_NAME)
cmake_host_system_information(RESULT arch QUERY OS_PLATFORM)
if(os_name STREQUAL "Windows")
  set(wheel "23/a6/90148f91544e3c056e78c514f0e764c1b44d50a33344c83fd03011ea97c8/clang_format-${version}-py2.py3-none-win_amd64.whl")
  set(sha256 6c2b74c3a3e942ec172d768e7b945f8e136db05a7b735d49ecfc69bda97643ad)
  set(exe clang-format.exe)
elseif(os_name STREQUAL "Linux" AND arch MATCHES "x86_64|AMD64")
  set(wheel "11/d1/658d3da4dcbca98620956868c7cf6f4ba19fccecbdfc30cc055e19c9d4a7/clang_format-${version}-py2.py3-none-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl")
  set(sha256 58bf1804216501669832a39f2415e14284337438a062ff564729792adec664ac)
elseif(os_name STREQUAL "Linux")
  set(wheel "1d/00/a0f99e24dc4892fb120e82fa9cf6e8fcb92714181ffd1165ab7eaf5ba1fd/clang_format-${version}-py2.py3-none-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl")
  set(sha256 072113527b49a9c0ab9058006d9fe20e583823e6482608a34e1883dd2c49ae7d)
elseif(os_name STREQUAL "macOS" AND arch STREQUAL "arm64")
  set(wheel "47/a5/2007b7a7a53dfe417e66d0a6b38b2f87f16391bfe6fe522d436d1e50be1c/clang_format-${version}-py2.py3-none-macosx_11_0_arm64.whl")
  set(sha256 79f53ac55434af6dda88eb90eeb65d903ff920c910f78041de41e3ca666dfba5)
elseif(os_name STREQUAL "macOS")
  set(wheel "05/0f/a1813ede1e149e700ee810baf22dd9c863ca0bd719d73f86e8c10b67a6bb/clang_format-${version}-py2.py3-none-macosx_10_9_x86_64.whl")
  set(sha256 0b8e86cc5a870ca42989bd1ccfe5220fbab96e386922d0a8f0ca350db30593df)
else()
  message(FATAL_ERROR "ClangFormat.cmake: no clang-format ${version} download for ${os_name} ${arch}")
endif()
if(NOT exe)
  set(exe clang-format)
endif()

get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(tool_dir "${root}/build/tools/clang-format-${version}")
set(clang_format "${tool_dir}/clang_format/data/bin/${exe}")
if(NOT EXISTS "${clang_format}")
  message(STATUS "Downloading clang-format ${version}")
  file(DOWNLOAD "${pypi}/${wheel}" "${tool_dir}/clang-format.whl" EXPECTED_HASH SHA256=${sha256} STATUS status)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "ClangFormat.cmake: download failed: ${status}")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${tool_dir}/clang-format.whl" DESTINATION "${tool_dir}")  # a wheel is a zip
  file(REMOVE "${tool_dir}/clang-format.whl")
  if(NOT os_name STREQUAL "Windows")
    file(CHMOD "${clang_format}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE
      WORLD_READ WORLD_EXECUTE)
  endif()
endif()

# The files: what git tracks (no build output, nothing generated), C++ only.
execute_process(COMMAND git ls-files -- engine kit tests benchmarks samples
  WORKING_DIRECTORY "${root}" OUTPUT_VARIABLE tracked RESULT_VARIABLE git_result)
if(NOT git_result EQUAL 0)
  message(FATAL_ERROR "ClangFormat.cmake: git ls-files failed")
endif()
string(REPLACE "\n" ";" tracked "${tracked}")
list(FILTER tracked INCLUDE REGEX "\\.(h|hpp|c|cc|cpp|inl)$")
list(LENGTH tracked count)

# In batches, so a command line stays short on Windows.
set(bad_files "")
set(batch "")
foreach(file IN LISTS tracked ITEMS "")
  if(file)
    list(APPEND batch "${file}")
  endif()
  list(LENGTH batch size)
  if(size GREATER 0 AND (size EQUAL 40 OR NOT file))
    if(CHECK)
      execute_process(COMMAND "${clang_format}" --dry-run --Werror ${batch}
        WORKING_DIRECTORY "${root}" ERROR_VARIABLE diagnostics OUTPUT_QUIET)
      string(REGEX MATCHALL "[^\n]+:[0-9]+:[0-9]+: error" errors "${diagnostics}")
      foreach(error IN LISTS errors)
        string(REGEX REPLACE ":[0-9]+:[0-9]+: error$" "" error_file "${error}")
        list(APPEND bad_files "${error_file}")
      endforeach()
    else()
      execute_process(COMMAND "${clang_format}" -i ${batch} WORKING_DIRECTORY "${root}" RESULT_VARIABLE result)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "ClangFormat.cmake: clang-format failed")
      endif()
    endif()
    set(batch "")
  endif()
endforeach()

if(CHECK)
  list(REMOVE_DUPLICATES bad_files)
  list(LENGTH bad_files bad_count)
  if(bad_count GREATER 0)
    list(JOIN bad_files "\n  " bad_list)
    message(FATAL_ERROR "${bad_count} of ${count} files aren't formatted (fix: cmake -P cmake/ClangFormat.cmake):\n  ${bad_list}")
  endif()
  message(STATUS "clang-format ${version}: ${count} files formatted")
else()
  message(STATUS "clang-format ${version}: formatted ${count} files")
endif()
