# Embeds the engine's shader files in a generated C++ source (run in script mode at build time):
#   cmake -DSHADER_DIR=<dir> -DOUTPUT=<file.cpp> -P EmbedShaders.cmake
# Every .glsl / .vert / .frag under SHADER_DIR becomes an entry {"relative/path", "text"} of
# rendering::EmbeddedShaderFiles() (shader_library.h). Text goes in as raw string literals, split in
# chunks: MSVC limits a single literal's length.

file(GLOB_RECURSE files RELATIVE "${SHADER_DIR}" "${SHADER_DIR}/*.glsl" "${SHADER_DIR}/*.vert" "${SHADER_DIR}/*.frag")
list(SORT files)

set(chunk_size 2000)
set(out "// Generated by cmake/EmbedShaders.cmake from ${SHADER_DIR}: don't edit.\n")
string(APPEND out "#include \"wlw/rendering/shader_library.h\"\n\nnamespace wlw::rendering {\nnamespace {\n\n")
string(APPEND out "const EmbeddedShaderFile kFiles[] = {\n")
foreach(name IN LISTS files)
  file(READ "${SHADER_DIR}/${name}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  string(FIND "${text}" ")wlwglsl\"" clash)
  if(NOT clash EQUAL -1)
    message(FATAL_ERROR "${name} contains the raw-string delimiter )wlwglsl\"")
  endif()
  string(APPEND out "    {\"${name}\",\n")
  string(LENGTH "${text}" length)
  set(start 0)
  while(start LESS length)
    string(SUBSTRING "${text}" ${start} ${chunk_size} chunk)
    string(APPEND out "     R\"wlwglsl(${chunk})wlwglsl\"\n")
    math(EXPR start "${start} + ${chunk_size}")
  endwhile()
  if(length EQUAL 0)
    string(APPEND out "     \"\"\n")
  endif()
  string(APPEND out "    },\n")
endforeach()
string(APPEND out "};\n\n}  // namespace\n\n")
string(APPEND out "std::span<const EmbeddedShaderFile> EmbeddedShaderFiles() { return kFiles; }\n\n")
string(APPEND out "}  // namespace wlw::rendering\n")

# Only rewrite when something changed, so dependents don't rebuild for nothing.
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
  if(previous STREQUAL out)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${out}")
