# Writes the engine's git commit, dirty flag and build type into a generated source (core/git_info.h declares
# them, core/build_info.h reads them). Runs on every build (the wlw_git_info target) but rewrites OUTPUT only when
# the text changes, so a new commit recompiles one small file and an unchanged one recompiles nothing.
#   cmake -DSOURCE_DIR=<engine checkout> -DOUTPUT=<file.cpp> -DBUILD_TYPE=<config> [-DGIT_EXECUTABLE=<git>]
#         -P cmake/GitInfo.cmake
# No git (a source archive, a machine without it): the commit is "unknown".
cmake_minimum_required(VERSION 3.21)

set(commit "unknown")
set(dirty "false")
if(GIT_EXECUTABLE)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=10 HEAD
    OUTPUT_VARIABLE head RESULT_VARIABLE result OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(result EQUAL 0 AND head MATCHES "^[0-9a-f]+$")
    set(commit "${head}")
    # Tracked files only; --no-optional-locks: never take index.lock (a git command running at the same time).
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" --no-optional-locks -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
      OUTPUT_VARIABLE changes RESULT_VARIABLE result ERROR_QUIET)
    if(result EQUAL 0 AND NOT changes STREQUAL "")
      set(dirty "true")
    endif()
  endif()
endif()
if(NOT BUILD_TYPE MATCHES "^[A-Za-z0-9_]+$")
  set(BUILD_TYPE "unknown")
endif()

set(text "// Generated by cmake/GitInfo.cmake at build time; don't edit.
#include \"wlw/core/git_info.h\"

namespace wlw::core::detail {

const char kGitCommit[] = \"${commit}\";
const bool kGitDirty = ${dirty};
const char kBuildType[] = \"${BUILD_TYPE}\";

}  // namespace wlw::core::detail
")

set(old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUTPUT}" "${text}")
endif()
